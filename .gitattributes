# Normalize line endings: everything stays LF in the repository.
* text=auto
*.py   text eol=lf
*.sh   text eol=lf
*.tcl  text eol=lf
*.v    text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.gitattributes text eol=lf
*.gitignore     text eol=lf
*LICENSE        text eol=lf